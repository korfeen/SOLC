# Packaging for releases (BigWigs packager, run by .github/workflows/release.yml).
# The zip contains the SOLC folder with only what the game needs, and the SOLC_Puzzle sister addon moved
# out next to it (in the repo it lives in a subfolder, which WoW wouldn't load).
package-as: SOLC

move-folders:
  SOLC/SOLC_Puzzle: SOLC_Puzzle

ignore:
  - tools
  - output
  - .claude
  - references
  - .vscode
  - .github
  - .gitignore
  - .gitattributes
  - README.md
  - CHANGELOG.md
  - SOLC_Fishing  # (the fishing addon: not shipped yet, tried by hand first)

# The release page's notes: the player-facing changelog, not every commit.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
